# ==========================================
# ORBIT Autonomous Desktop Assistant - Environment Template
# ==========================================

# 1. Google Gemini API (Get key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# 2. OpenAI API (Get key at: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# 3. Anthropic Claude API (Get key at: https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4. Local Ollama Endpoint (Default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# 5. Runtime & Safety Configuration
ORBIT_HUMAN_TAKEOVER_ENABLED=false
ORBIT_PORT=8765
